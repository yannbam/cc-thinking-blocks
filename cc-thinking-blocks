#!/usr/bin/env node

/**
 * cc-thinking-blocks
 *
 * Extracts thinking blocks from Claude Code session files.
 * Supports multiple modes for viewing assistant thinking blocks.
 */

const fs = require('fs');
const path = require('path');
const os = require('os');

/**
 * Find session file by UUID in ~/.claude/projects/
 * Returns the full path to the session file or null if not found
 */
function findSessionFile(sessionId) {
    const projectsDir = path.join(os.homedir(), '.claude', 'projects');

    if (!fs.existsSync(projectsDir)) {
        return null;
    }

    function searchDirectory(dir) {
        try {
            const entries = fs.readdirSync(dir, { withFileTypes: true });

            for (const entry of entries) {
                const fullPath = path.join(dir, entry.name);

                if (entry.isDirectory()) {
                    const result = searchDirectory(fullPath);
                    if (result) return result;
                } else if (entry.isFile() && entry.name === `${sessionId}.jsonl`) {
                    return fullPath;
                }
            }
        } catch (error) {
            return null;
        }

        return null;
    }

    return searchDirectory(projectsDir);
}

/**
 * Find newest session file for a project directory
 */
function findNewestSessionFileForProject(projectDir) {
    // Sanitize project directory path
    const sanitizedPath = projectDir.replace(/\//g, '-');
    const projectsDir = path.join(os.homedir(), '.claude', 'projects');
    const targetDir = path.join(projectsDir, sanitizedPath);

    console.log(targetDir);

    if (!fs.existsSync(targetDir)) {
        return null;
    }

    try {
        const files = fs.readdirSync(targetDir)
            .filter(file => file.endsWith('.jsonl'))
            .map(file => ({
                name: file,
                path: path.join(targetDir, file),
                mtime: fs.statSync(path.join(targetDir, file)).mtime
            }))
            .sort((a, b) => b.mtime - a.mtime);

        return files.length > 0 ? files[0].path : null;
    } catch (error) {
        return null;
    }
}

/**
 * Extract text content from message content (handles both string and array formats)
 */
function extractMessageText(messageContent) {
    if (typeof messageContent === 'string') {
        return messageContent;
    }

    if (Array.isArray(messageContent) && messageContent.length > 0) {
        // Find the last block of type 'text'
        for (let i = messageContent.length - 1; i >= 0; i--) {
            const block = messageContent[i];
            if (block && block.type === 'text' && typeof block.text === 'string') {
                return block.text;
            }
        }
    }

    return null;
}

/**
 * Determine if a message is a real user message (not hook output, tool result, etc.)
 * This is the single source of truth for user message detection
 */
function isRealUserMessage(message, lineIndex) {
    // Must be user type and not a sidechain message
    if (message.type !== 'user' || message.isSidechain || message.isVisibleInTranscriptOnly) {
        return false;
    }

    // Must have extractable text content
    const messageText = message.message && message.message.content ?
        extractMessageText(message.message.content) : null;

    if (!messageText) {
        return false;
    }

    const content = messageText.trim();

    // Filter out specific isMeta messages that are system-generated caveats
    if (message.isMeta && content.startsWith('Caveat: The messages below were generated by the user')) {
        return false;
    }

    // Filter out hook messages (any XML tag ending with "-hook>")
    if (content.startsWith('<') && content.includes('>')) {
        const firstTagEnd = content.indexOf('>');
        const firstTag = content.substring(0, firstTagEnd + 1);
        if (firstTag.endsWith('-hook>')) {
            return false;
        }
    }

    // Filter out other system injections
    const filteredPrefixes = ['<system-reminder>', '<command-name>', '<local-command-stdout>', '<bash-input>','[Request interrupted by user','<bash-stdout>','<command-message>'];
    if (filteredPrefixes.some(prefix => content.startsWith(prefix))) {
        return false;
    }

    return true;
}

/**
 * Parse session file using complete processing for all modes
 * This ensures turn numbers are always accurate
 */
function parseSessionFile(filePath, mode) {
    try {
        const fileContent = fs.readFileSync(filePath, 'utf8');
        const lines = fileContent.trim().split('\n').filter(line => line.trim());

        // Parse all lines into structured format with line indices
        const parsedLines = [];
        for (let i = 0; i < lines.length; i++) {
            try {
                const message = JSON.parse(lines[i]);
                parsedLines.push({
                    lineIndex: i,
                    message: message,
                    isRealUserMessage: isRealUserMessage(message, i)
                });
            } catch (parseError) {
                // Skip invalid JSON lines but maintain line indexing
                parsedLines.push({
                    lineIndex: i,
                    message: null,
                    isRealUserMessage: false
                });
            }
        }

        // Get real user message line indices for turn boundary detection
        const realUserLines = parsedLines
            .filter(line => line.isRealUserMessage)
            .map(line => line.lineIndex);

        // Always use complete processing to get accurate turn numbers
        return parseComplete(parsedLines, realUserLines);

    } catch (error) {
        console.error('Error reading session file:', error.message);
        process.exit(1);
    }
}


/**
 * Complete processing for all modes
 * Processes entire file to ensure accurate turn numbering
 */
function parseComplete(parsedLines, realUserLines) {
    const assistantTurns = [];
    let currentTurn = null;

    // Add sentinel at beginning for turn boundary detection
    const userBoundaries = [-1, ...realUserLines, parsedLines.length];
    let currentUserBoundaryIndex = 0;

    for (let i = 0; i < parsedLines.length; i++) {
        const line = parsedLines[i];
        if (!line.message) continue;

        // Check if we've crossed a user message boundary
        if (currentUserBoundaryIndex + 1 < userBoundaries.length &&
            i >= userBoundaries[currentUserBoundaryIndex + 1]) {
            // We've reached a real user message - end current turn if exists
            if (currentTurn) {
                currentTurn.triggerUserLineIndex = userBoundaries[currentUserBoundaryIndex];
                assistantTurns.push(currentTurn);
                currentTurn = null;
            }
            currentUserBoundaryIndex++;
        }

        if (line.message.type === 'assistant' && !line.message.isSidechain) {
            // Assistant message - either start new turn or continue current
            if (!currentTurn) {
                currentTurn = {
                    startLineIndex: i,
                    endLineIndex: i,
                    thinkingBlocks: [],
                    triggerUserLineIndex: null,
                    timestamp: line.message.timestamp
                };
            } else {
                currentTurn.endLineIndex = i; // Extend turn forwards
            }

            // Extract thinking blocks
            if (line.message.message && line.message.message.content) {
                for (const block of line.message.message.content) {
                    if (block.type === 'thinking') {
                        currentTurn.thinkingBlocks.push({
                            type: 'thinking',
                            content: block.thinking,
                            signature: block.signature
                        });
                    } else if (block.type === 'redacted_thinking') {
                        currentTurn.thinkingBlocks.push({
                            type: 'redacted_thinking',
                            content: '**redacted**'
                        });
                    }
                }
            }
        }
    }

    // Handle final turn if it exists
    if (currentTurn) {
        currentTurn.triggerUserLineIndex = userBoundaries[currentUserBoundaryIndex];
        assistantTurns.push(currentTurn);
    }

    return { turns: assistantTurns, allLines: parsedLines };
}

/**
 * Get the user message that triggered a turn by line index
 */
function getTriggerUserMessage(allLines, triggerLineIndex) {
    if (triggerLineIndex === null || triggerLineIndex === -1) {
        return null;
    }

    const line = allLines[triggerLineIndex];
    return line && line.message ? line.message : null;
}

/**
 * Count characters, words, and lines in text
 */
function getTextStats(text) {
    const lines = text.split('\n').length;
    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
    const chars = text.length;
    return { chars, words, lines };
}

/**
 * Create a preview of user message content for correlation
 */
function getUserMessagePreview(userMessage) {
    if (!userMessage || !userMessage.message || !userMessage.message.content) {
        return 'Unknown user message';
    }

    let content = extractMessageText(userMessage.message.content);
    if (!content) {
        return 'Unknown user message';
    }

    const maxLength = 80;

    // Strip all newlines from user message
    content = content.replace(/\n/g, ' ').replace(/\s+/g, ' ').trim();

    if (content.length <= maxLength) {
        return `"${content}"`;
    }

    // Truncate in the middle with ...
    const halfLength = Math.floor((maxLength - 3) / 2);
    const start = content.substring(0, halfLength);
    const end = content.substring(content.length - halfLength);
    return `"${start}...${end}"`;
}

/**
 * Debug mode: Show all user messages with line indices
 */
function debugUserMessages(filePath) {
    try {
        const fileContent = fs.readFileSync(filePath, 'utf8');
        const lines = fileContent.trim().split('\n').filter(line => line.trim());

        console.log('=== DEBUG: All User Messages ===');
        console.log('Format: [lineIndex] isReal | message preview\n');

        // Collect all user messages first
        const userMessages = [];
        for (let i = 0; i < lines.length; i++) {
            try {
                const message = JSON.parse(lines[i]);

                if (message.type === 'user') {
                    const isReal = isRealUserMessage(message, i);
                    const messageText = message.message && message.message.content ?
                        extractMessageText(message.message.content) : null;

                    const preview = messageText ?
                        messageText.replace(/\n/g, ' ').replace(/\s+/g, ' ').trim().substring(0, 100) :
                        '[no text content]';

                    const status = isReal ? '✓ REAL' : '✗ filtered';

                    userMessages.push({
                        lineIndex: i+1,
                        status: status,
                        preview: preview,
                        isReal: isReal
                    });
                }
            } catch (parseError) {
                // Skip invalid JSON lines
            }
        }

        // Sort: filtered messages first, then real messages
        userMessages.sort((a, b) => {
            if (a.isReal === b.isReal) {
                return a.lineIndex - b.lineIndex; // Maintain original order for same type
            }
            return a.isReal ? 1 : -1; // Filtered (false) before real (true)
        });

        // Output sorted messages
        for (const msg of userMessages) {
            console.log(`[${msg.lineIndex}] ${msg.status} | ${msg.preview}`);
        }

        console.log('\n=== End Debug ===');
    } catch (error) {
        console.error('Error in debug mode:', error.message);
        process.exit(1);
    }
}

/**
 * Output thinking blocks
 */
function outputThinkingBlocks(blocks, turnNumber = null) {
    if (blocks.length === 0) {
        console.log('No thinking blocks found.');
        return;
    }

    // Add turn header if turn number is provided
    if (turnNumber !== null) {
        console.log(`Message: ${turnNumber}`);
        console.log('');
    }

    for (let i = 0; i < blocks.length; i++) {
        const block = blocks[i];

        if (blocks.length > 1) {
            console.log(`--- Thinking Block ${i + 1} ---`);
        }

        console.log(block.content);

        if (i < blocks.length - 1) {
            console.log('');
        }
    }
}

