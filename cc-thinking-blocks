// Main execution
function main() {
    const args = process.argv.slice(2);

    if (args.length === 0 || args.includes('--help')) {
        showHelp();
        process.exit(0);
    }

    let sessionId = null;
    let projectDir = null;
    let mode = 'previous';
    let turnNumber = null;
    let debugMode = false;

    // Parse arguments
    for (let i = 0; i < args.length; i++) {
        if (args[i] === '--project-path') {
            if (i + 1 >= args.length) {
                console.error('Error: --project-path requires a path argument');
                process.exit(1);
            }
            try {
                projectDir = fs.realpathSync(args[i + 1]);
            } catch (error) {
                console.error(`Error: Invalid project path: ${args[i + 1]} - ${error.message}`);
                process.exit(1);
            }
            i++; // Skip next argument
        } else if (args[i] === '--debug') {
            debugMode = true;
        } else if (args[i] === 'message') {
            if (i + 1 >= args.length) {
                console.error('Error: message mode requires a message number');
                process.exit(1);
            }
            mode = 'turn';
            turnNumber = parseInt(args[i + 1]);
            if (isNaN(turnNumber) || turnNumber < 1) {
                console.error('Error: message number must be a positive integer');
                process.exit(1);
            }
            i++; // Skip next argument
        } else if (['previous', 'current', 'list'].includes(args[i])) {
            mode = args[i];
        } else if (!sessionId && !projectDir) {
            sessionId = args[i];
        } else {
            console.error(`Error: Unknown argument: ${args[i]}`);
            process.exit(1);
        }
    }

    // Find session file
    let filePath = null;
    if (projectDir) {
        filePath = findNewestSessionFileForProject(projectDir);
        if (!filePath) {
            console.error(`Error: No session files found for project directory: ${projectDir}`);
            process.exit(1);
        }
    } else if (sessionId) {
        filePath = findSessionFile(sessionId);
        if (!filePath) {
            console.error(`Error: Session file not found for session-id: ${sessionId}`);
            process.exit(1);
        }
    } else {
        console.error('Error: Must provide either session-id or --project-path');
        process.exit(1);
    }

    // Handle debug mode
    if (debugMode) {
        debugUserMessages(filePath);
        return;
    }

    // Parse session file with mode-aware processing
    const { turns, allLines } = parseSessionFile(filePath, mode);

    // Filter turns that have thinking blocks
    const turnsWithThinking = turns.filter(turn => turn.thinkingBlocks.length > 0);

    // Execute mode
    switch (mode) {
        case 'previous':
            if (turnsWithThinking.length >= 2) {
                const previousTurn = turnsWithThinking[turnsWithThinking.length - 2];
                // Find actual turn number in complete turns array
                const actualTurnIndex = turns.findIndex(turn => turn === previousTurn);
                const turnNumber = actualTurnIndex + 1; // Convert to 1-based numbering
                outputThinkingBlocks(previousTurn.thinkingBlocks, turnNumber);
            } else {
                console.log('No previous assistant message with thinking blocks found.');
            }
            break;

        case 'current':
            if (turnsWithThinking.length >= 1) {
                const currentTurn = turnsWithThinking[turnsWithThinking.length - 1];
                // Find actual turn number in complete turns array
                const actualTurnIndex = turns.findIndex(turn => turn === currentTurn);
                const turnNumber = actualTurnIndex + 1; // Convert to 1-based numbering
                outputThinkingBlocks(currentTurn.thinkingBlocks, turnNumber);
            } else {
                console.log('No current assistant message with thinking blocks found.');
            }
            break;

        case 'list':
            if (turnsWithThinking.length === 0) {
                console.log('No assistant messages with thinking blocks found.');
            } else {
                console.log('Assistant messages with thinking blocks:');
                console.log('[message#] Human: user message preview → <think>first/last lines</think> → block count: (word counts)\n');
                for (let i = 0; i < turnsWithThinking.length; i++) {
                    const turn = turnsWithThinking[i];

                    // Get the trigger user message using line index
                    const triggerMessage = getTriggerUserMessage(allLines, turn.triggerUserLineIndex);
                    const userPreview = getUserMessagePreview(triggerMessage);

                    console.log(`[${i + 1}] Human: ${userPreview}`);

                    // Show first and last line of the first (usually main) thinking block
                    if (turn.thinkingBlocks.length > 0) {
                        const mainBlock = turn.thinkingBlocks[0];
                        const lines = mainBlock.content.split('\n');
                        const firstLine = lines[0].trim();
                        const lastLine = lines.length > 1 ? lines[lines.length - 1].trim() : '';

                        console.log(`   <think> ${firstLine}`);
                        if (lastLine && lastLine !== firstLine && lastLine.length > 0) {
                            console.log(`   [...]`);
                            console.log(`   ${lastLine} </think>`);
                        } else {
                            console.log(`   </think>`);
                        }
                    }

                    // Show word counts for all thinking blocks in one line
                    const wordCounts = turn.thinkingBlocks.map(block => getTextStats(block.content).words);
                    console.log(`   ${turn.thinkingBlocks.length} blocks: (${wordCounts.join(', ')})\n`);
                }
            }
            break;

        case 'turn':
            if (turnNumber > turns.length) {
                console.log(`Message ${turnNumber} not found. Only ${turns.length} assistant messages available.`);
            } else {
                const targetTurn = turns[turnNumber - 1];
                if (targetTurn.thinkingBlocks.length > 0) {
                    outputThinkingBlocks(targetTurn.thinkingBlocks);
                } else {
                    console.log(`Message ${turnNumber} found but has no thinking blocks.`);
                }
            }
            break;
    }
}

if (require.main === module) {
    main();
}
